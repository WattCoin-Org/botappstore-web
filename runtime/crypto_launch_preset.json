{
  "brand": "YOUR TOKEN",
  "state_dir": "./state",
  "hmac_secret_env": "LAUNCH_HUB_HMAC_SECRET",
  "approval_ttl_days": 3,
  "lint": {
    "allowed_domains": ["pump.fun", "dexscreener.com", "geckoterminal.com", "rugcheck.xyz", "x.com", "discord.gg"],
    "banned_terms": ["guaranteed", "risk-free", "100x", "1000x", "moon", "lambo", "can't lose", "buy now", "last chance", "financial advice for you"],
    "max_hashtags": 2,
    "max_mentions": 2
  },
  "channels": {
    "x": {"enabled": true, "mode": "intent", "handle": "@YourToken",
          "pricing_note": "2026 X API pay-per-use: $0.015 per plain post, $0.20 per post that contains a URL. Web Intents are free and 1-click.",
          "cost_plain_usd": 0.015, "cost_link_usd": 0.20,
          "credentials_env": {"consumer_key": "X_CONSUMER_KEY", "consumer_secret": "X_CONSUMER_SECRET", "access_token": "X_ACCESS_TOKEN", "token_secret": "X_TOKEN_SECRET"}},
    "discord": {"enabled": true, "webhooks_env": {"announcements": "DISCORD_WEBHOOK_ANNOUNCEMENTS"}},
    "bluesky": {"enabled": false, "service": "https://bsky.social", "handle_env": "BSKY_HANDLE", "app_password_env": "BSKY_APP_PASSWORD"},
    "telegram": {"enabled": true, "bot_token_env": "TELEGRAM_BOT_TOKEN", "chat_id_env": "TELEGRAM_CHAT_ID"}
  },
  "audit": {"expected_websites": [], "expected_discord": "", "expected_x": ""}
}
